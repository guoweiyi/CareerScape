# 单写 Node 服务。本地默认 mock，不产生模型费用。
DATABASE_PATH=.data/careerscape.sqlite
AI_PROVIDER=mock
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# 新AI职业故事支持Google原生或OpenAI兼容模型；完成真实smoke后设为1。
GALGAME_ENABLED=0
GALGAME_DAILY_TURNS=30
GALGAME_TIMEOUT_MS=60000
GALGAME_MAX_OUTPUT_TOKENS=2000
APP_ORIGIN=http://127.0.0.1:3000
# production 强制 Secure Cookie；部署必须启用 HTTPS。
# 独立 .output 部署可设为 public 的绝对路径
ASSET_PUBLIC_DIR=
