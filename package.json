{
  "name": "careerscape",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "nuxt dev apps/web --host 127.0.0.1",
    "build": "nuxt build apps/web",
    "preview": "node apps/web/.output/server/index.mjs",
    "prepare": "nuxt prepare apps/web",
    "typecheck": "nuxt typecheck apps/web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:backup": "tsx scripts/db.ts backup",
    "content:plan": "tsx scripts/content/cli.ts plan",
    "content:generate": "tsx scripts/content/cli.ts generate",
    "content:validate": "tsx scripts/content/cli.ts validate",
    "content:publish": "tsx scripts/content/cli.ts publish"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.86",
    "@ai-sdk/vue": "4.0.130",
    "@nuxt/ui": "4.11.3",
    "@pinia/nuxt": "1.0.2",
    "ai": "7.0.130",
    "argon2": "0.45.1",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.3",
    "h3": "1.15.11",
    "nuxt": "4.6.0",
    "pinia": "4.0.3",
    "tailwindcss": "4.3.3",
    "vue": "3.5.43",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.4",
    "@vue/test-utils": "2.5.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "msw": "2.15.0",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
